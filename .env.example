# ============================================================
# FarmPilotAI – environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- API ---
APP_NAME=FarmPilotAI
APP_ENV=development          # development | staging | production
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_CORS_ORIGINS=["*"]

# --- Database (async SQLAlchemy DSN; aiosqlite for local dev) ---
DATABASE_URL=sqlite+aiosqlite:///./data/farmpilot.db
DATABASE_ECHO=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false               # true => structured JSON logs to stdout
LOG_FILE=./logs/farmpilot.log

# --- Browser / Playwright ---
BROWSER_HEADLESS=true
BROWSER_CHANNEL=chromium     # chromium | chrome | msedge
BROWSER_PROFILES_DIR=./profiles
BROWSER_EXTENSIONS_DIR=./extensions
BROWSER_DEFAULT_TIMEOUT_MS=30000
BROWSER_USER_AGENT=

# --- Wallet ---
WALLET_EXTENSION=metamask    # metamask | rabby | none
WALLET_EXTENSION_PATH=       # absolute path to unpacked wallet extension
# DO NOT put real mnemonics in shared envs. Use a vault.
WALLET_DEFAULT_MNEMONIC=
WALLET_DEFAULT_PASSWORD=

# --- EVM RPC endpoints (comma separated key=url pairs) ---
EVM_RPCS=ethereum=https://eth.llamarpc.com,arbitrum=https://arb1.arbitrum.io/rpc,base=https://mainnet.base.org

# --- AI reasoning ---
AI_PROVIDER=openai           # openai | anthropic | none
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# --- Execution policy ---
EXEC_MAX_CONCURRENCY=2
EXEC_HUMAN_DELAY_MIN_MS=600
EXEC_HUMAN_DELAY_MAX_MS=2400
EXEC_RETRY_MAX_ATTEMPTS=4
EXEC_RETRY_BACKOFF_BASE_MS=500
EXEC_RETRY_BACKOFF_MAX_MS=15000
EXEC_RISK_MAX_USD=25         # block transactions above this notional
EXEC_DRY_RUN=true            # if true, no on-chain signing performed

# --- Planner ---
PLANNER_ETH_PRICE_USD=3000           # used to convert gas units * gwei to USD
PLANNER_DEFAULT_GAS_GWEI=30          # fallback when chain RPC is unreachable
PLANNER_OPPORTUNITY_THRESHOLD=0.3    # below this, planner returns verdict=needs_review
PLANNER_RISK_THRESHOLD=0.75          # at or above this, planner returns verdict=skip
